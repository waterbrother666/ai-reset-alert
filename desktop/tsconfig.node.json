{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "electron-vite/node", "vitest/globals"]
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/monitor/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts", "electron.vite.config.ts", "vitest.config.ts"]
}
