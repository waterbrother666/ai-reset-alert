{
  "name": "ai-reset-alert",
  "productName": "ai-reset-alert",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p ../tsconfig.json",
    "test": "npm rebuild better-sqlite3 && vitest run",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && npm run rebuild:electron && electron-builder --dir",
    "dist": "npm run build && npm run rebuild:electron && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
